# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
node_modules_old*
node_modules_backup*
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/
build

# other
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# turbo
.turbo

#jetbrains IDEs
.idea

.cache

.strapi-updater.json
node_modules_*
node_modules*

# Security - Scripts with potential passwords
**/fix-*.ts
**/fix-*.js
**/check-*.ts
**/check-*.js
**/debug-*.ts
**/debug-*.js
**/test-*.ts
**/test-*.js
**/update-*.ts
**/update-*.js
**/publish-*.ts
**/publish-*.js
**/assign-*.ts
**/assign-*.js
**/clear-*.ts
**/clear-*.js
**/compare-*.ts
**/compare-*.js
**/find-*.ts
**/find-*.js
**/simple-*.ts
**/simple-*.js
**/activate-*.ts
**/activate-*.js

# Temporary scripts
temp-*.ts
temp-*.js
script-*.ts
script-*.js

# TypeScript compiled files from Strapi and Next.js
apps/strapi/config/**/*.js
apps/strapi/config/**/*.js.map
apps/strapi/src/**/*.js
apps/strapi/src/**/*.js.map
apps/strapi/types/**/*.js
apps/strapi/types/**/*.js.map
apps/strapi/scripts/**/*.js
apps/strapi/scripts/**/*.js.map
apps/web/sentry.*.config.js
apps/web/sentry.*.config.js.map

# Prevent accidental .js compilation in TypeScript projects
apps/web/src/**/*.js
apps/web/src/**/*.js.map

# Ignore compiled .js in TypeScript-only demo folders
# catalyst-ui-kit has both /javascript (real .js) and /typescript (should not have .js)
catalyst-ui-kit/typescript/**/*.js
catalyst-ui-kit/typescript/**/*.js.map
# radiant-ts is TypeScript only - no .js should exist except in node_modules
radiant-ts/src/**/*.js
radiant-ts/src/**/*.js.map
radiant-ts/*.js
!radiant-ts/postcss.config.js
!radiant-ts/prettier.config.js

# TypeScript build info files
*.tsbuildinfo
!**/dist/*.tsbuildinfo

# Database backup files with potential sensitive data
**/*.sql
**/Backup/
**/backups/

# Environment files with sensitive data
.env.local
.env.development
.env.production
**/.env.local
**/.env.development
**/.env.production
.tmp*

# next.js generated types
next-env.d.ts
*.tsbuildinfo
