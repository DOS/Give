# Shared DOS Supabase project (publishable/anon key only here; never the service key).
NEXT_PUBLIC_SUPABASE_URL=https://gulptwduchsjcsbndmua.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of this app, used for OAuth redirect URIs.
# Canonical origin: login runs here and builds the OAuth redirect_uri from it.
# Leave unset on Vercel previews to use each preview's own origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for the guest donation rate limit, at least 32 random
# characters. Required in Production; previews fall back to the service-role
# key, and local runs send no key.
GIVE_RATE_LIMIT_SECRET=
# Supabase OAuth 2.1 server (DOS.Me login). Register a client with redirect
# URI ${NEXT_PUBLIC_SITE_URL}/auth/callback.
OIDC_ISSUER=https://gulptwduchsjcsbndmua.supabase.co/auth/v1
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Email (DOS/Give#254): AWS SES over SMTP, the provider DOS.Me uses. Sending
# stays off (the send-outbox job claims nothing) until SMTP_USER, SMTP_PASS
# and EMAIL_FROM are set. give.vn must be a verified SES identity (SPF, DKIM,
# DMARC).
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Give <no-reply@give.vn>"
EMAIL_REPLY_TO=hi@give.vn
# Origin of links in emails; defaults to NEXT_PUBLIC_SITE_URL, then
# https://give.vn in Production. Set https://beta.give.vn for beta.
EMAIL_LINK_ORIGIN=
